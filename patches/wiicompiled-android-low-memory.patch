@@ -0,0 +1,34 @@
+#pragma once
+
+#include <cstddef>
+
+namespace aurora::gfx {
+
+struct PipelineMemoryPolicy {
+  size_t maxWorkers;
+  size_t maxBackgroundWorkers;
+  size_t bootPrewarmBuilds;
+  size_t scenePrewarmBuilds;
+  size_t retainedShaderModules;
+};
+
+constexpr PipelineMemoryPolicy pipeline_memory_policy(bool constrainedMemory) noexcept {
+  if (constrainedMemory) {
+    return {
+        .maxWorkers = 2,
+        .maxBackgroundWorkers = 1,
+        .bootPrewarmBuilds = 32,
+        .scenePrewarmBuilds = 64,
+        .retainedShaderModules = 64,
+    };
+  }
+  return {
+      .maxWorkers = 22,
+      .maxBackgroundWorkers = 1,
+      .bootPrewarmBuilds = 128,
+      .scenePrewarmBuilds = 384,
+      .retainedShaderModules = 0,
+  };
+}
+
+} // namespace aurora::gfx
