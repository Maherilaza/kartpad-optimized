diff --git a/aurora-main/tests/pipeline_memory_policy_test.cpp b/aurora-main/tests/pipeline_memory_policy_test.cpp
new file mode 100644
index 0000000..364f187
--- /dev/null
+++ b/aurora-main/tests/pipeline_memory_policy_test.cpp
@@ -0,0 +1,25 @@
+#include "gfx/pipeline_memory_policy.hpp"
+
+#include <gtest/gtest.h>
+
+namespace aurora::gfx {
+
+TEST(PipelineMemoryPolicy, PreservesNormalCompilationPolicy) {
+  const auto policy = pipeline_memory_policy(false);
+  EXPECT_EQ(policy.maxWorkers, 22);
+  EXPECT_EQ(policy.maxBackgroundWorkers, 1);
+  EXPECT_EQ(policy.bootPrewarmBuilds, 128);
+  EXPECT_EQ(policy.scenePrewarmBuilds, 384);
+  EXPECT_EQ(policy.retainedShaderModules, 0);
+}
+
+TEST(PipelineMemoryPolicy, BoundsConstrainedDeviceCompilation) {
+  const auto policy = pipeline_memory_policy(true);
+  EXPECT_EQ(policy.maxWorkers, 2);
+  EXPECT_EQ(policy.maxBackgroundWorkers, 1);
+  EXPECT_EQ(policy.bootPrewarmBuilds, 32);
+  EXPECT_EQ(policy.scenePrewarmBuilds, 64);
+  EXPECT_EQ(policy.retainedShaderModules, 64);
+}
+
+} // namespace aurora::gfx
